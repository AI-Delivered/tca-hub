# Supabase — create a project at supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic — get key at console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Voyage — used for retrieval embeddings (voyage-3-lite)
VOYAGE_API_KEY=pa-...

# Secret to protect the manual crawl triggers (generate any random string)
CRAWL_SECRET=your-random-secret

# Set this to the same value in Vercel and the scheduler will send it as
# `Authorization: Bearer $CRON_SECRET` on every cron run — which is what the
# ingest routes verify. Without it they fall back to trusting the x-vercel-cron
# header, which is a claim rather than a proof.
CRON_SECRET=your-random-secret

# Password for the /nerds analytics dashboard. REQUIRED — with it unset the
# dashboard returns 503 rather than falling back to a default password.
ADMIN_PASSWORD=choose-something-long

# Optional. Lets /nerds show what Anthropic actually billed next to this app's
# own estimate, via the organization usage_report and cost_report endpoints.
# This is an ADMIN key (sk-ant-admin01-…), a different credential from
# ANTHROPIC_API_KEY above — created in the Anthropic Console by an org
# owner/admin, and it cannot be used for inference. Unset, the panel renders a
# setup note instead of failing.
ANTHROPIC_ADMIN_KEY=sk-ant-admin01-...

# Optional, and only meaningful alongside the key above. The admin key is
# organization-scoped, so token counts cover every project in the org until this
# narrows them to the one key TCA Hub uses. The id of the key behind
# ANTHROPIC_API_KEY, not the key itself. Cost is always org-wide — the cost
# report has no api_key filter.
ANTHROPIC_ADMIN_API_KEY_ID=apikey_...

# Crawl target
CRAWL_TARGET_URL=https://www.tcatitans.org
